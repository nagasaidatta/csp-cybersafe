# Supabase Configuration
# Replace these with your Supabase Project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Side Supabase Configuration (Never exposed to frontend code)
# Required for Admin Dashboard to read user completion metrics across all learners
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Admin Credentials for Dashboard (Defaults: admin / cybersafe)
# ADMIN_ID=admin
# ADMIN_PASSWORD=cybersafe

# Google Gemini API Configuration (Server-Side Only)
# Required for Link Safety Checker and Message Safety Checker
GEMINI_API_KEY=your-gemini-api-key

# Optional: Gemini Model ID (defaults to gemini-1.5-flash for lowest token usage and high stability)
GEMINI_MODEL=gemini-1.5-flash
